{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "apercu": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "apercu"
    },
    "essai": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "channel": "essai",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
