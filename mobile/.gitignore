# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# La carte d'identite du projet Firebase. Elle arrive par un secret de
# fichier EAS (voir app.config.js), jamais par le depot.
google-services.json
GoogleService-Info.plist

# La cle du compte de service Google Play, qui autorise le depot automatique
# au magasin. Elle arrive par un secret GitHub, le temps d'un envoi, et le
# robot l'efface aussitot. Qui la tient peut publier a la place du
# proprietaire : elle n'a rien a faire ici.
google-play.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
